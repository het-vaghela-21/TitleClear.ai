# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# gujrera trial connector — local response cache and scratch research files
src/lib/connectors/gujrera/__cache__/
.tmp-gujrera-research/

# internal research notes — not for the public repo
/research/

# tesseract.js traineddata cache (downloaded on first OCR run; lands in cwd
# unless TESSERACT_LANG_PATH is set)
src/lib/ocr/.tesseract-cache/
/*.traineddata

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# document library — files uploaded at /documents/library (see
# src/lib/doc-library/README.md). Override the location with DOC_LIBRARY_DIR.
/storage/
