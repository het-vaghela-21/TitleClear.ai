# GujRERA trial connector — off by default. See
# src/lib/connectors/gujrera/NOTES.md and PROJECT_CONTEXT.md's "Trial
# exception: GujRERA connector" section before turning this on.
RERA_CONNECTOR_ENABLED=false

# OCR module (src/lib/ocr) — synthetic-data workstream, see src/lib/ocr/README.md.
# "tesseract" (offline, default without a Vision key) | "google" | "surya" (stub) |
# "vlm" (stub — targets Qwen2.5-VL, see providers/vlm-provider.ts)
OCR_PROVIDER=tesseract
# Required only for --provider google.
GOOGLE_VISION_API_KEY=
# Local traineddata cache dir for tesseract.js, for fully offline/deterministic runs.
TESSERACT_LANG_PATH=
# Field extractor (stage 2) provider: "mock" (default, offline/deterministic) | "anthropic"
FIELD_EXTRACTOR_PROVIDER=mock
# Required only for FIELD_EXTRACTOR_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Everything this app persists to disk — uploaded documents, accounts and
# sessions. Defaults to ./storage (gitignored). See src/lib/storage.ts.
STORAGE_DIR=
